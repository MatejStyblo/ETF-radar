# Test-only hiring project; use synthetic emails, not real customer data.
# Capture remains disabled until the local database and secrets are configured.
LEADS_ENABLED=false
DEMO_MODE=false
# Read-only contacts dashboard: opt in only on a loopback-bound local server.
# Never enable as a public administration interface; no production login is implemented.
DASHBOARD_ENABLED=false
# Remote dashboard requires HTTPS, explicit opt-in and both independent secrets.
DASHBOARD_REMOTE_ENABLED=false
# SHA-256 of a generated 32-byte base64url access key (never the raw key).
DASHBOARD_ACCESS_KEY_HASH=
DASHBOARD_SESSION_SECRET=
DATABASE_URL=
APP_ORIGIN=http://localhost:3000
# Independently generated server-only secrets, at least 32 characters each.
LEAD_DEDUPE_SECRET=
REPORT_TOKEN_SECRET=
# Name supplied by the user for the test project (not a production legal identity).
CONTROLLER_NAME="Matěj STýblo"
# Deliberately nonfunctional test address, not the user's real contact.
PRIVACY_CONTACT=test@example.invalid
# Dedicated integration database (tests use no production connection).
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:55439/etf_radar_test
